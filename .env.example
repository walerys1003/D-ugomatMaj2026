# =============================================================================
# DŁUGOMAT — environment variables (template)
# Copy to .env.local for local development. NEVER commit real secrets.
# =============================================================================

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Supabase (self-hosted or cloud) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never expose
SUPABASE_DB_URL=                  # for migrations / pgTAP

# ---- AI (Claude via APIPod.ai) ----------------------------------------------
APIPOD_API_KEY=
APIPOD_BASE_URL=https://apipod.ai
CLAUDE_MODEL_GENERATE=claude-sonnet-4-6
CLAUDE_MODEL_VALIDATE=claude-haiku-4-5
CLAUDE_MODEL_ESCALATE=claude-opus-4-6
# Fallback bezpośredni do Anthropic (gdy APIPod niedostępny). Opcjonalny.
ANTHROPIC_API_KEY=
# Budżet AI — guardrail kosztowy (assertWithinBudget). ZALECANE na produkcji.
AI_USAGE_DAILY_CAP_USD=50
AI_USAGE_CASE_CAP_USD=5
# Chaos engineering — wymuszona degradacja AI (test UX). Tylko non-prod.
DLUGOMAT_AI_DEGRADE=false
DLUGOMAT_AI_DEGRADE_RATE=0
# Zewnętrzne API prawnicze / RAG reranker — opcjonalne.
LEX_API_KEY=
LEX_API_BASE=
LEGALMIND_API_KEY=
LEGALMIND_API_BASE=
COHERE_API_KEY=
LOCAL_RERANKER_URL=
# (Legacy) OpenAI — używane wyłącznie przez wycofywany lib/ai/llm-client.ts.
OPENAI_API_KEY=

# ---- OCR ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
TEXTRACT_BUCKET=

# ---- Payments ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
FAKTUROWNIA_API_TOKEN=
FAKTUROWNIA_DOMAIN=

# ---- Notifications -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@dlugomat.pl
SMSAPI_TOKEN=
SMSAPI_SENDER=Dlugomat
# Web Push (VAPID) — kanał push w dispatchNotification (audyt #10).
# Wygeneruj parę: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@dlugomat.pl
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- Observability -----------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Security ----------------------------------------------------------------
ENCRYPTION_KEY=                   # 32-byte base64 for pgcrypto / app-level
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Cron / Jobs -------------------------------------------------------------
# Bearer secret chroniący endpointy /api/cron/*. WYMAGANE na produkcji —
# bez niego cron zwraca 401, ale ustaw silny losowy token.
CRON_SECRET=

# ---- Rate limit backend (rozproszony) ----------------------------------------
# Gdy ustawione — rate-limit używa Upstash Redis (REST) zamiast in-memory.
# Wymagane przy >1 instancji / serverless (patrz audyt #2).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
