# =============================================================================
# DEV-PREVIEW — przykładowa konfiguracja do WIZUALNEGO podglądu paneli
# (/panel i /admin) BEZ żywego backendu Supabase.
#
# Użycie:
#   cp apps/web/.env.preview.example apps/web/.env.local
#   npm run dev   (w apps/web)
#
# Mechanizm: lib/dev/preview.ts + lib/dev/mock-supabase.ts wstrzykują mockowego
# użytkownika (user@demo.dlugomat.pl) i admina (admin@demo.dlugomat.pl) oraz
# klient-mock Supabase zwracający puste, bezbłędne wyniki — strony renderują
# swoje empty-state zamiast się wywracać.
#
# BEZPIECZEŃSTWO: flaga działa WYŁĄCZNIE gdy NODE_ENV != production. Na
# produkcji jest ignorowana, więc nie ominie autentykacji. NIE commituj
# .env.local (jest w .gitignore).
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Włącza tryb podglądu paneli bez żywego Supabase.
NEXT_PUBLIC_DEV_PREVIEW=1

# Supabase celowo PUSTE — wymusza ścieżkę mock-klienta.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_RADCA_ENABLED=false
