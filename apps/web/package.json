{
  "name": "@dlugomat/web",
  "version": "0.0.1",
  "private": true,
  "description": "Długomat — Next.js 14 application (App Router, TypeScript, Tailwind, shadcn/ui).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > lib/db/types.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true next build",
    "build:profile": "next build --profile",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "^3.1075.0",
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-accordion": "1.2.14",
    "@radix-ui/react-checkbox": "1.3.5",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@radix-ui/react-label": "2.1.10",
    "@radix-ui/react-popover": "1.1.17",
    "@radix-ui/react-progress": "1.1.10",
    "@radix-ui/react-select": "2.3.1",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.15",
    "@radix-ui/react-toast": "1.2.17",
    "@radix-ui/react-tooltip": "1.2.10",
    "@sentry/nextjs": "^10.62.0",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.395.0",
    "puppeteer-core": "^23.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.80.0",
    "resend": "^4.8.0",
    "stripe": "^16.12.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "tesseract.js": "5.1.1",
    "web-push": "^3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "^2.1.4",
    "autoprefixer": "10.5.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "15.2.10",
    "postcss": "8.5.16",
    "prettier": "3.9.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
