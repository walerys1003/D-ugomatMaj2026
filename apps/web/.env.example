# =============================================================================
# Długomat — środowisko Next.js (apps/web)
# =============================================================================
# Skopiuj do .env.local i uzupełnij wartości:
#   cp apps/web/.env.example apps/web/.env.local
#
# UWAGA: Pliki .env.local są w .gitignore — nie commit'uj kluczy.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplikacja
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Tier 1+)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI — Claude (Tier 3)
# -----------------------------------------------------------------------------
# Preferowany gateway: APIPod.ai (rate-limit, retry, monitoring)
APIPOD_API_KEY=
APIPOD_BASE_URL=https://gateway.apipod.ai/anthropic

# Fallback bezpośredni do Anthropic (gdy APIPod nie odpowiada)
ANTHROPIC_API_KEY=

# Modele (override domyślnych z lib/ai/models.ts)
ANTHROPIC_MODEL_GENERATOR=claude-sonnet-4-5-20250929
ANTHROPIC_MODEL_VALIDATOR=claude-haiku-4-5-20250929
ANTHROPIC_MODEL_ESCALATOR=claude-opus-4-5-20250929

# -----------------------------------------------------------------------------
# OCR — Tesseract działa client-side; Textract jako server fallback (Tier 3.3)
# -----------------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Stripe (Tier 4.1+4.2)
# -----------------------------------------------------------------------------
# 1. Załóż konto na https://dashboard.stripe.com (PL VAT 23%)
# 2. Skopiuj klucze z Developers → API keys
# 3. Webhook: Developers → Webhooks → Add endpoint
#      URL: https://dlugomat.pl/api/stripe/webhook
#      Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#              checkout.session.async_payment_failed, charge.refunded,
#              payment_intent.payment_failed
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cennik trzymamy w `lib/payments/pricing.ts` (single source of truth).
# Stripe Checkout używa inline price_data — nie potrzebujemy Stripe Price IDs.

# -----------------------------------------------------------------------------
# Fakturownia (Tier 4.3) — automatyczne wystawianie faktur VAT
# -----------------------------------------------------------------------------
# 1. Załóż konto na https://app.fakturownia.pl
# 2. Ustawienia → API → wygeneruj token
# 3. Domena to subdomena Twojego konta (np. "dlugomat" dla dlugomat.fakturownia.pl)
FAKTUROWNIA_API_TOKEN=
FAKTUROWNIA_DOMAIN=
# Opcjonalnie — NIP sprzedawcy w fakturach
SELLER_NIP=

# -----------------------------------------------------------------------------
# Email — Resend (Tier 5.4) — powiadomienia transakcyjne i terminowe
# -----------------------------------------------------------------------------
# 1. Załóż konto na https://resend.com
# 2. Domain → dodaj dlugomat.pl, ustaw SPF/DKIM/DMARC
# 3. API Keys → wygeneruj klucz (osobny dla prod / staging)
RESEND_API_KEY=
# Format zgodny z RFC: "Long Name <addr@domain>" lub "addr@domain"
RESEND_FROM_EMAIL=Długomat <powiadomienia@dlugomat.pl>
# Adres do "Reply-To" (domyślnie pomoc@dlugomat.pl)
RESEND_REPLY_TO=pomoc@dlugomat.pl

# -----------------------------------------------------------------------------
# SMS — SMSAPI.pl (Tier 5.4) — przypomnienia D3/D1/D0
# -----------------------------------------------------------------------------
# 1. Załóż konto na https://smsapi.pl (RODO-compliant, dane w PL)
# 2. Ustawienia → API → OAuth2 → wygeneruj długi token (zalecane bez expiry)
# 3. Pole nadawcy: zarejestruj 3-11 znaków (np. "Dlugomat")
SMSAPI_OAUTH_TOKEN=
SMSAPI_SENDER=Dlugomat

# -----------------------------------------------------------------------------
# CRON / Edge Functions (Tier 5.4) — Supabase deadline-cron
# -----------------------------------------------------------------------------
# Bearer token używany przez:
#   - supabase/functions/deadline-cron (POST /api/notifications/dispatch)
#   - dowolne wewnętrzne CRON-y (set jako Authorization: Bearer <secret>)
# Wygeneruj losowo: openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# Sentry / monitoring (Tier 5 zad. 248)
# -----------------------------------------------------------------------------
# Public DSN (klient + serwer). Pusty → Sentry wyłączony.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time tylko (upload sourcemaps przez @sentry/nextjs build hook)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Encryption at rest (Tier 5 zad. 207) — pgcrypto AES-256
# -----------------------------------------------------------------------------
# Wygeneruj 32+ znaków: openssl rand -base64 48
# UWAGA: rotacja klucza wymaga re-encryption migration — patrz docs/RUNBOOK.md
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# File scanning (Tier 5 zad. 205) — ClamAV INSTREAM
# -----------------------------------------------------------------------------
# Opcjonalnie — gdy ustawiony, pliki są skanowane antywirusowo
CLAMAV_HOST=
CLAMAV_PORT=3310
# REQUIRE_CLAMAV=1 → fail-closed (odrzuć upload gdy ClamAV niedostępny).
# W produkcji REKOMENDOWANE.
REQUIRE_CLAMAV=

# -----------------------------------------------------------------------------
# Referrals (Tier 5 zad. 246)
# -----------------------------------------------------------------------------
# Salt używany do hashowania IP w referral_clicks (RODO-friendly).
# Wygeneruj: openssl rand -hex 16. Rotuj co 30 dni dla anty-fraud.
REFERRAL_IP_SALT=

# -----------------------------------------------------------------------------
# Build / deploy (auto-set on Vercel — nie ustawiaj lokalnie)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_BUILD_SHA=auto
# VERCEL_GIT_COMMIT_SHA=auto
# VERCEL_ENV=production|preview|development
# SKIP_PROD_ENV_CHECK=1 # tylko dla awaryjnego deploy bez kompletnego env
